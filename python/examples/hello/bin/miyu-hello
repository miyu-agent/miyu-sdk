#!/usr/bin/env python3
"""The hello extension, written with miyu_ext: copy miyu_ext.py into this bin/ folder, then `miyu pkg install` the folder."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from miyu_ext import Extension  # noqa: E402

ext = Extension("hello", "0.1.0")


@ext.tool("hello_greet", "Greet someone by name.",
          {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]},
          access="read", display_name={"en": "Greet", "zh": "打招呼"}, subject="name", clicall=True)
def greet(args, call):
    return f"{ext.config.get('hello.greeting', 'Hello')}, {args['name']}!"


if __name__ == "__main__":
    if sys.argv[1:] == ["serve"]:
        ext.run()
    else:
        print("usage: miyu-hello serve (started by the Miyu core)", file=sys.stderr)
        sys.exit(2)
